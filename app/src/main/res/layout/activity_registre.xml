<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".a_views.RegistreActivity">

        <TextView
            android:id="@+id/textView"
            android:layout_width="243dp"
            android:layout_height="29dp"
            android:layout_marginTop="60dp"
            android:gravity="center"
            android:text="Registre d'usuari"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/emailRegistreEditText"
            android:layout_width="295dp"
            android:layout_height="48dp"
            android:layout_marginTop="44dp"
            android:ems="10"
            android:hint="Correu Electrónic"
            android:inputType="textEmailAddress"
            app:layout_constraintStart_toStartOf="@+id/nomRegistreEditText"
            app:layout_constraintTop_toBottomOf="@+id/nomRegistreEditText" />

        <EditText
            android:id="@+id/nomRegistreEditText"
            android:layout_width="295dp"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:ems="10"
            android:hint="Nom d'usuari"
            android:inputType="text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView" />

        <EditText
            android:id="@+id/contrasenyaRegistreEditText"
            android:layout_width="295dp"
            android:layout_height="48dp"
            android:layout_marginTop="40dp"
            android:ems="10"
            android:hint="Contrasenya"
            android:inputType="textPassword"
            app:layout_constraintStart_toStartOf="@+id/emailRegistreEditText"
            app:layout_constraintTop_toBottomOf="@+id/emailRegistreEditText" />

        <Button
            android:id="@+id/registreButton"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="244dp"
            android:layout_height="48dp"
            android:layout_marginTop="144dp"
            android:text="Registrar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/contrasenyaRegistreEditText" />

        <TextView
            android:id="@+id/iniciarSessioLinkText"
            android:layout_width="297dp"
            android:layout_height="16dp"
            android:layout_marginTop="20dp"
            android:text="@string/iniciar_sessio_link"
            app:layout_constraintStart_toStartOf="@+id/contrasenyaRegistreEditText"
            app:layout_constraintTop_toBottomOf="@+id/contrasenyaRegistreEditText" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>