<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".a_views.LoginActivity"
        android:background="@color/app_background">

        <TextView
            android:id="@+id/titolLoginText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="144dp"
            android:text="Benvingut a CafeFlow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.465"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/usuariLoginEditText"
            android:layout_width="340dp"
            android:layout_height="60dp"
            android:ems="10"
            android:hint="Correu"
            android:inputType="text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titolLoginText" />

        <EditText
            android:id="@+id/contrasenyaLoginEditText"
            android:layout_width="340dp"
            android:layout_height="60dp"
            android:layout_marginTop="40dp"
            android:ems="10"
            android:hint="Contrasenya"
            android:inputType="textPassword"
            app:layout_constraintStart_toStartOf="@+id/usuariLoginEditText"
            app:layout_constraintTop_toBottomOf="@+id/usuariLoginEditText" />

        <Button
            android:id="@+id/loginButton"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="228dp"
            android:layout_height="58dp"
            android:layout_marginTop="172dp"
            android:text="Iniciar Sessió"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/contrasenyaLoginEditText" />

        <TextView
            android:id="@+id/linkRegistrarText"
            android:layout_width="192dp"
            android:layout_height="41dp"
            android:layout_marginTop="44dp"
            android:text="@string/crear_compte_link"
            app:layout_constraintStart_toStartOf="@+id/contrasenyaLoginEditText"
            app:layout_constraintTop_toBottomOf="@+id/contrasenyaLoginEditText" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>