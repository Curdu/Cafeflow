<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="186dp"
        >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <ImageView
                android:id="@+id/producteImageView"
                android:layout_width="141dp"
                android:layout_height="186dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/outline_add_shopping_cart_24" />

            <TextView
                android:id="@+id/titolProducteText"
                android:layout_width="239dp"
                android:layout_height="38dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="16dp"
                android:text="Producte"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/producteImageView"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/preuProducteText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="88dp"
                android:layout_marginTop="20dp"
                android:text="00.00 €"
                app:layout_constraintStart_toStartOf="@+id/titolProducteText"
                app:layout_constraintTop_toBottomOf="@+id/titolProducteText" />

            <Button
                android:id="@+id/eliminarProducteButton"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="178dp"
                android:layout_height="54dp"
                android:layout_marginTop="116dp"
                android:layout_marginEnd="52dp"
                android:text="Eliminar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </com.google.android.material.card.MaterialCardView>
</layout>
