<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="186dp"
        >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <ImageView
                android:id="@+id/begudaImageView"
                android:layout_width="141dp"
                android:layout_height="186dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/outline_beer_meal_24" />

            <TextView
                android:id="@+id/titolBegudaText"
                android:layout_width="239dp"
                android:layout_height="38dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="16dp"
                android:text="Beguda"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/begudaImageView"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/preuBegudaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:text="00.00 €"
                app:layout_constraintStart_toStartOf="@+id/titolBegudaText"
                app:layout_constraintTop_toBottomOf="@+id/titolBegudaText" />

            <TextView
                android:id="@+id/volumBegudaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="52dp"
                android:layout_marginBottom="52dp"
                android:text="00 cl"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/preuBegudaText"
                app:layout_constraintTop_toTopOf="@+id/preuBegudaText"
                app:layout_constraintVertical_bias="0.0" />

            <Button
                android:id="@+id/afegirBegudaButton"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="178dp"
                android:layout_height="54dp"
                android:layout_marginTop="116dp"
                android:layout_marginEnd="52dp"
                android:text="Afegir"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </com.google.android.material.card.MaterialCardView>
</layout>
